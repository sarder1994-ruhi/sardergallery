# Application Port & URLs
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Optional Remote API Backend (for Netlify/Vercel static deployments connecting to external server)
# If left empty, the frontend uses local published store data automatically
VITE_API_URL=""

# Sarder Gallery Business Contacts
BUSINESS_PHONE="+8801700000000"
BUSINESS_WHATSAPP="+8801700000000"
BUSINESS_EMAIL="contact@sardergallery.com"

# Payment Gateways (Optional - Can also be configured directly via Admin Dashboard)
# bKash Merchant Configuration
BKASH_MERCHANT_NUMBER="01XXXXXXXXX"
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_TEST_MODE="true"

# Nagad Merchant Configuration
NAGAD_MERCHANT_NUMBER="01XXXXXXXXX"
NAGAD_TEST_MODE="true"

# SSLCommerz Configuration
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASS="your_store_password"
SSLCOMMERZ_SANDBOX="true"

# Courier Services (Optional - Can also be configured directly via Admin Dashboard)
# Pathao Courier API
PATHAO_API_KEY="your_pathao_api_key"
PATHAO_SECRET="your_pathao_secret"

# Steadfast Courier API
STEADFAST_API_KEY="your_steadfast_api_key"
STEADFAST_SECRET="your_steadfast_secret"

# RedX Courier API
REDX_BEARER_TOKEN="your_redx_bearer_token"

# Analytics Configuration (Optional)
META_PIXEL_ID="your_meta_pixel_id"
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
